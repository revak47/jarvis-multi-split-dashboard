{
    "manifest_version":  3,
    "name":  "Jarvis Multi-Split Dashboard",
    "version":  "1.5.0",
    "description":  "Painel de produtividade multi-tela em grade com navegaÃ§Ã£o por espaÃ§os, gaveta de atalhos e envio simultÃ¢neo para IAs.",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "Jarvis Multi-Split",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "32":  "icons/icon32.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "permissions":  [
                        "storage",
                        "tabs"
                    ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://chatgpt.com/*",
                                                "https://claude.ai/*",
                                                "https://gemini.google.com/*",
                                                "https://www.perplexity.ai/*",
                                                "https://chat.deepseek.com/*",
                                                "https://grok.com/*",
                                                "https://x.com/i/grok*",
                                                "https://*.manus.im/*"
                                            ],
                                "js":  [
                                           "ai-broadcast.js"
                                       ],
                                "all_frames":  true,
                                "run_at":  "document_end"
                            },
                            {
                                "matches":  [
                                                "https://web.whatsapp.com/*"
                                            ],
                                "js":  [
                                           "whatsapp-mobile.js"
                                       ],
                                "css":  [
                                            "whatsapp-mobile.css"
                                        ],
                                "all_frames":  true,
                                "run_at":  "document_end"
                            }
                        ],
    "commands":  {
                     "toggle-topbar":  {
                                           "suggested_key":  {
                                                                 "default":  "Alt+Shift+H"
                                                             },
                                           "description":  "Mostrar ou ocultar barra superior"
                                       }
                 }
}
